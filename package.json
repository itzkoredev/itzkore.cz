{
  "name": "itzkore-cz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
  "build:dist": "npm run build && node scripts\\build-dist.cjs",
  "build:export": "node scripts\\export-static.cjs",
    "start": "next start",
    "lint": "next lint",
  "clean": "node -e \"const fs=require('fs'),p=['.next','node_modules/.cache','.turbo'];p.forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}});console.log('cleaned:',p.join(', '))\"",
  "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});console.log('removed dist')\"",
  "clean:swc": "node -e \"const fs=require('fs');const p=['.next','node_modules/@next','.turbo'];p.forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}});console.log('removed:',p.join(', '))\"",
  "clean:hard": "node -e \"const fs=require('fs');const p=['.next','node_modules','.turbo','package-lock.json'];p.forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}});console.log('removed:',p.join(', '))\"",
    "format": "prettier --write .",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
  "next": "^15.5.2",
  "react": "^18.3.1",
  "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
  "eslint-config-next": "^15.5.2",
  "cross-env": "^7.0.3",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
